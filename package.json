{
  "name": "wycats-ai-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Personal agent toolkit: workflow agents, skills, instructions, and hooks.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "build": "node scripts/build.ts",
    "build:codex": "node scripts/build.ts --config config.codex.example.json",
    "build:pi": "node scripts/build.ts --config config.pi.example.json",
    "watch": "node scripts/watch.ts",
    "install-local": "node scripts/install-local.ts",
    "launch-claude": "node scripts/launch-claude.ts",
    "package-codex": "node scripts/package-codex.ts",
    "publish-cc": "node scripts/publish-cc.ts",
    "publish-codex": "node scripts/publish-codex.ts",
    "publish-pi": "node scripts/publish-pi.ts",
    "test:pi-publication": "node --test scripts/publish-pi.test.ts",
    "publish-vscode": "node scripts/publish-vscode.ts",
    "eval": "node scripts/eval/run.ts",
    "test:eval": "node --test scripts/eval/core.test.ts scripts/eval/resource.test.ts scripts/eval/run.test.ts scripts/eval/adapters/claude-code.test.ts",
    "test:composition": "node --test scripts/resource-composition.test.ts scripts/pi-projection.test.ts scripts/pi-subagents-integration.test.ts",
    "test:pi-runtime": "node --test scripts/pi-subagents-integration.test.ts",
    "test-cc": "node scripts/test-cc.ts",
    "validate": "node scripts/validate.ts",
    "lint": "eslint scripts/",
    "check": "tsc --noEmit && eslint scripts/ && pnpm test:eval && pnpm test:composition && pnpm test:pi-publication"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.0.3",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@wycats/agent-hooks": "workspace:*",
    "gray-matter": "^4.0.3",
    "jsonc-parser": "^3.3.1"
  },
  "pnpm": {
    "overrides": {}
  }
}
